# Copy to `.env` on the server (same directory as docker-compose.yml) and fill in real values.
# This file never touches Jenkins or git — it's a server-local secret.

DB_DATABASE=whatsmine
DB_USERNAME=whatsmine
DB_PASSWORD=change-me-to-a-real-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-real-password
APP_URL=https://yourdomain.com
